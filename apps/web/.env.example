OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MANAGEMENT_KEY=optional_openrouter_management_or_balance_key
OPENROUTER_WARNING_BALANCE_USD=25
OPENROUTER_CRITICAL_BALANCE_USD=10

# Central OpenRouter model-family routing for Verified Mode
SVA_GPT_PRIMARY=openai/gpt-4.1-mini
SVA_GPT_FALLBACK=openai/gpt-4.1-nano
SVA_GEMINI_PRIMARY=google/gemini-2.5-flash
SVA_GEMINI_FALLBACK=google/gemini-2.5-flash-lite
SVA_DEEPSEEK_PRIMARY=deepseek/deepseek-chat
SVA_DEEPSEEK_FALLBACK=
SVA_SYNTHESIS_PRIMARY=openai/gpt-4.1-mini
SVA_SYNTHESIS_FALLBACK=openai/gpt-4.1-nano

RETRIEVAL_PROVIDER=web
WEB_RETRIEVAL_ENDPOINT=https://google.serper.dev/search
WEB_RETRIEVAL_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Founder admin (server API uses ADMIN_EMAIL; /admin page also needs NEXT_PUBLIC_ADMIN_EMAIL)
ADMIN_EMAIL=founder@example.com
NEXT_PUBLIC_ADMIN_EMAIL=founder@example.com

# Supabase (service role is server-only - never expose in client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Razorpay Test Mode (server-only secret - never expose RAZORPAY_KEY_SECRET)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here


NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

